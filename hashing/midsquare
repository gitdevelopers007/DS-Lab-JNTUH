#include <stdio.h>

int midSquareMethod(int key, int tableSize)
{
    int square = key * key;
    int middleDigits = (square / 10) % 100;

    return middleDigits % tableSize;
}

int main()
{
    int key, tableSize;

    printf("Mid-Square Method\n");

    printf("Enter key: ");
    scanf("%d", &key);

    printf("Enter hash table size: ");
    scanf("%d", &tableSize);

    printf("Hash Value: %d\n",
           midSquareMethod(key, tableSize));

    return 0;
}

